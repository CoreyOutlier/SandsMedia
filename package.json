{
  "name": "sandsmedia-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate --config prisma7.config.ts && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:auth": "node scripts/auth-smoke.mjs",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "db:seed": "prisma db seed --config prisma7.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
