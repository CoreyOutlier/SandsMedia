APP_URL=https://photos.example.com
CLINIC_SLUG=dr-sands
DATABASE_URL=postgresql://posting_center_app:PASSWORD@HOST/DATABASE?sslmode=verify-full
# Selected method: Shared Drive + service account. Server only.
GOOGLE_SERVICE_ACCOUNT_JSON=REPLACE_WITH_BASE64_SERVICE_ACCOUNT_JSON
DRIVE_ROOT_FOLDER_ID=REPLACE_WITH_SHARED_DRIVE_OR_ROOT_FOLDER_ID
# Dashboard Google OAuth is separate from service-account Drive access.
AUTH_SECRET=REPLACE_WITH_RANDOM_AUTH_SECRET
AUTH_GOOGLE_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
AUTH_GOOGLE_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET
ALLOWED_EMAILS=staff@example.com,agency@example.com
COOKIE_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_COOKIE_SECRET
SHARE_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SHARE_SECRET
# Keep true until the practice confirms its patient-data compliance setup.
SYNTHETIC_TEST_MODE=true
MAX_VIDEO_MB=5120
CONSENT_TEXT_VERSION=1
# Development seed only. Never enable fixture seeding on the production database.
SEED_DEMO_DATA=false
SEED_CLINIC_PASSCODE_HASH=REPLACE_WITH_BCRYPT_HASH
# Platform-provided values shown for completeness; do not override in Vercel.
# NODE_ENV=development
# VERCEL_ENV=development
# Neon provisioning aliases (not read by the application).
# Removed from Vercel when switching to the restricted runtime connection.
# Keep owner credentials only in a separate, ignored administrative environment.
# DATABASE_URL_UNPOOLED=postgresql://MIGRATION_USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require&sslaccept=strict
# NEON_PROJECT_ID=REPLACE_WITH_NEON_PROJECT_ID
# PGHOST=REPLACE_WITH_POOLED_HOST
# PGHOST_UNPOOLED=REPLACE_WITH_DIRECT_HOST
# PGUSER=REPLACE_WITH_DATABASE_USER
# PGPASSWORD=REPLACE_WITH_DATABASE_PASSWORD
# PGDATABASE=REPLACE_WITH_DATABASE_NAME
# POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
# POSTGRES_PRISMA_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# POSTGRES_URL_NO_SSL=postgresql://USER:PASSWORD@HOST/DATABASE
# POSTGRES_USER=REPLACE_WITH_DATABASE_USER
# POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
# POSTGRES_HOST=REPLACE_WITH_DATABASE_HOST
# POSTGRES_DATABASE=REPLACE_WITH_DATABASE_NAME

# Authenticates the nightly Drive reconciliation job. Server only.
CRON_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_CRON_SECRET
