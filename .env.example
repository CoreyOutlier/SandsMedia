APP_URL=https://photos.example.com
CLINIC_SLUG=dr-sands
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Selected method: Shared Drive + service account. Server only.
GOOGLE_SERVICE_ACCOUNT_JSON=REPLACE_WITH_BASE64_SERVICE_ACCOUNT_JSON
DRIVE_ROOT_FOLDER_ID=REPLACE_WITH_SHARED_DRIVE_OR_ROOT_FOLDER_ID
# Dashboard Google OAuth is separate from service-account Drive access.
AUTH_SECRET=REPLACE_WITH_RANDOM_AUTH_SECRET
AUTH_GOOGLE_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
AUTH_GOOGLE_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET
ALLOWED_EMAILS=staff@example.com,agency@example.com
COOKIE_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_COOKIE_SECRET
SHARE_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SHARE_SECRET
MAX_VIDEO_MB=500
CONSENT_TEXT_VERSION=1
# Development seed only. Never enable fixture seeding on the production database.
SEED_DEMO_DATA=false
SEED_CLINIC_PASSCODE_HASH=REPLACE_WITH_BCRYPT_HASH
# Platform-provided values shown for completeness; do not override in Vercel.
# NODE_ENV=development
# VERCEL_ENV=development
